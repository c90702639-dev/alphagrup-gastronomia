---
import SiteLayout from "../layouts/SiteLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import { products, brands, categories, priceFor } from "../lib/products";

const destacados = products
  .filter((p) => p.brand === "Rational" || priceFor(p).discountPct >= 12)
  .slice(0, 8);

const catCounts = categories.map((c) => ({
  name: c,
  count: products.filter((p) => p.category === c).length,
}));
---

<SiteLayout title="Equipos profesionales de cocina">
  {/* ── HERO ─────────────────────────────────────────── */}
  <section class="border-b border-linea bg-papel-2/60">
    <div class="container-x grid items-center gap-10 py-16 lg:grid-cols-[1.15fr_1fr] lg:py-24">
      <div>
        <p class="eyebrow">División Gastronomía</p>
        <h1 class="mt-3 text-4xl font-semibold leading-[1.05] sm:text-5xl lg:text-6xl">
          Equipos diseñados para
          <span class="text-cobre italic">ritmos intensos</span> de trabajo.
        </h1>
        <p class="mt-5 max-w-lg text-lg leading-relaxed text-tinta-2">
          Cocinas multifuncionales con las mejores marcas del mundo.
          Precios transparentes, descuentos por volumen y cotización en minutos.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/productos" class="btn btn-primary px-7 py-3.5">Ver productos</a>
          <a href="/cotizacion" class="btn btn-outline px-7 py-3.5">Solicitar cotización</a>
        </div>
        <dl class="mt-10 grid max-w-md grid-cols-3 gap-6 border-t border-linea pt-6">
          <div><dt class="eyebrow !text-tinta-3">Marcas</dt><dd class="font-display text-2xl font-semibold">{brands.length}+</dd></div>
          <div><dt class="eyebrow !text-tinta-3">Modelos</dt><dd class="font-display text-2xl font-semibold">{products.length}</dd></div>
          <div><dt class="eyebrow !text-tinta-3">Países</dt><dd class="font-display text-2xl font-semibold">7</dd></div>
        </dl>
      </div>

      <div class="relative hidden lg:block">
        <div class="absolute -top-4 -left-4 size-full border border-cobre" aria-hidden="true"></div>
        <img
          src={destacados[0]?.localImage || "/favicon.svg"}
          alt="Horno combi profesional Rational iCOMBI PRO"
          width="520"
          height="420"
          fetchpriority="high"
          class="relative aspect-[13/10] w-full border border-linea bg-white object-contain p-8"
        />
        <figcaption class="absolute bottom-4 left-4 bg-tinta px-3 py-1.5 text-xs font-medium tracking-wide text-papel">
          RATIONAL · iCOMBI PRO
        </figcaption>
      </div>
    </div>
  </section>

  {/* ── MARCAS ───────────────────────────────────────── */}
  <section class="border-b border-linea">
    <div class="container-x py-12">
      <p class="text-center text-sm font-medium text-tinta-3">
        Distribuidores autorizados de las mejores marcas
      </p>
      <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
        {
          brands.map((b) => (
            <li class="font-display text-xl font-semibold text-tinta/35 transition-colors hover:text-cobre">
              {b}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── CATEGORÍAS ───────────────────────────────────── */}
  <section class="container-x py-16">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Catálogo</p>
        <h2 class="mt-2 text-3xl font-semibold">Explora por categoría</h2>
      </div>
      <a href="/productos" class="hidden text-sm font-semibold text-cobre hover:underline sm:block">
        Ver todo →
      </a>
    </div>

    <div class="mt-8 grid grid-cols-2 gap-px overflow-hidden border border-linea bg-linea md:grid-cols-4">
      {
        catCounts.map((c) => (
          <a
            href={`/productos?cat=${encodeURIComponent(c.name)}`}
            class="group bg-papel p-6 transition-colors hover:bg-papel-2"
          >
            <span class="font-display text-3xl font-semibold text-acero-2 transition-colors group-hover:text-cobre">
              {String(c.count).padStart(2, "0")}
            </span>
            <p class="mt-2 font-medium leading-snug group-hover:text-cobre">{c.name}</p>
          </a>
        ))
      }
    </div>
  </section>

  {/* ── DESTACADOS ───────────────────────────────────── */}
  <section class="border-y border-linea bg-papel-2/50">
    <div class="container-x py-16">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Selección del mes</p>
          <h2 class="mt-2 text-3xl font-semibold">Destacados y ofertas</h2>
        </div>
        <a href="/productos" class="hidden text-sm font-semibold text-cobre hover:underline sm:block">
          Ver todo →
        </a>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {destacados.slice(0, 8).map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  {/* ── BANDA DE VALOR ──────────────────────────────── */}
  <section class="container-x py-16">
    <div class="grid gap-px overflow-hidden border border-linea bg-linea md:grid-cols-3">
      <div class="bg-white p-8">
        <span class="font-display text-4xl font-semibold text-cobre">%</span>
        <h3 class="mt-3 text-xl font-semibold">Descuentos reales</h3>
        <p class="mt-2 text-sm leading-relaxed text-tinta-2">
          Descuentos visibles por volumen y temporada. Sin precios ocultos ni llamadas innecesarias.
        </p>
      </div>
      <div class="bg-white p-8">
        <span class="font-display text-4xl font-semibold text-cobre">IA</span>
        <h3 class="mt-3 text-xl font-semibold">Asistente técnico con IA</h3>
        <p class="mt-2 text-sm leading-relaxed text-tinta-2">
          Nuestro equipo responde especificaciones técnicas al instante usando IA entrenada con las fichas oficiales.
        </p>
      </div>
      <div class="bg-white p-8">
        <span class="font-display text-4xl font-semibold text-cobre">7</span>
        <h3 class="mt-3 text-xl font-semibold">Latinoamérica entera</h3>
        <p class="mt-2 text-sm leading-relaxed text-tinta-2">
          Presencia local en México, Guatemala, Costa Rica, Colombia, Perú, El Salvador y República Dominicana.
        </p>
      </div>
    </div>
  </section>

  {/* ── CTA FINAL ────────────────────────────────────── */}
  <section class="bg-tinta py-20 text-center text-papel">
    <div class="container-x">
      <p class="eyebrow !text-cobre-claro">¿Listo para equipar tu cocina?</p>
      <h2 class="mx-auto mt-3 max-w-2xl text-3xl font-semibold leading-tight sm:text-4xl">
        Agenda una demo con nuestros especialistas hoy mismo.
      </h2>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/agenda-una-demo" class="btn btn-primary px-7 py-3.5">Agenda una demo</a>
        <a href="/productos" class="btn px-7 py-3.5 text-papel outline outline-1 outline-papel/40 hover:bg-papel hover:text-tinta">
          Explorar catálogo
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
