---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Contacto" description="Contacta a Grupo Alpha: soporte técnico, ventas y cotizaciones para toda Latinoamérica.">
  <section class="border-b border-linea bg-papel-2/60">
    <div class="container-x py-14">
      <p class="eyebrow">Contacto</p>
      <h1 class="mt-3 text-4xl font-semibold">Estamos para servirte</h1>
    </div>
  </section>

  <section class="container-x grid gap-12 py-16 lg:grid-cols-2">
    <form
      class="space-y-4"
      method="POST"
      action="/api/contacto"
      netlify-compatible
    >
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block text-sm font-medium">Nombre *
          <input required name="nombre" class="mt-1.5 w-full border border-linea bg-white px-3.5 py-2.5 text-sm focus:border-cobre focus:outline-none" />
        </label>
        <label class="block text-sm font-medium">Empresa
          <input name="empresa" class="mt-1.5 w-full border border-linea bg-white px-3.5 py-2.5 text-sm focus:border-cobre focus:outline-none" />
        </label>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block text-sm font-medium">Correo *
          <input required type="email" name="email" class="mt-1.5 w-full border border-linea bg-white px-3.5 py-2.5 text-sm focus:border-cobre focus:outline-none" />
        </label>
        <label class="block text-sm font-medium">Teléfono
          <input name="telefono" class="mt-1.5 w-full border border-linea bg-white px-3.5 py-2.5 text-sm focus:border-cobre focus:outline-none" />
        </label>
      </div>
      <label class="block text-sm font-medium">Mensaje *
        <textarea required name="mensaje" rows="5" class="mt-1.5 w-full border border-linea bg-white px-3.5 py-2.5 text-sm focus:border-cobre focus:outline-none"></textarea>
      </label>
      <button class="btn btn-primary px-8 py-3">Enviar mensaje</button>
      <p class="text-xs text-tinta-3">También puedes escribirnos por WhatsApp para respuesta inmediata.</p>
    </form>

    <aside class="space-y-6">
      <div class="border border-linea bg-white p-7">
        <h2 class="font-display text-xl font-semibold">Horarios</h2>
        <p class="mt-3 text-sm leading-relaxed text-tinta-2">
          Lunes a Viernes: 9:00 – 18:30<br />
          Sábado: 9:00 – 14:00
        </p>
      </div>
      <div class="border border-linea bg-white p-7">
        <h2 class="font-display text-xl font-semibold">Soporte técnico</h2>
        <p class="mt-3 space-y-1 text-sm text-tinta-2">
          <a href="tel:5555332385" class="block hover:text-cobre">55 5533 2385</a>
          <a href="mailto:soporte@grupoalpha.com" class="block hover:text-cobre">soporte@grupoalpha.com</a>
        </p>
      </div>
      <div class="border border-linea bg-white p-7">
        <h2 class="font-display text-xl font-semibold">WhatsApp directo</h2>
        <a href="https://wa.me/5215555332385" target="_blank" rel="noopener" class="btn btn-primary mt-4 w-full">
          Chatear ahora
        </a>
      </div>
    </aside>
  </section>
</SiteLayout>
