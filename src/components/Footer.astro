---
const year = new Date().getFullYear();
const paises = [
  "México",
  "Guatemala",
  "Costa Rica",
  "Colombia",
  "Perú",
  "El Salvador",
  "República Dominicana",
];
---

<footer class="border-t border-linea bg-tinta text-papel">
  <div class="container-x grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-2.5">
        <span class="grid size-9 place-items-center bg-cobre font-display text-lg font-bold text-white">α</span>
        <span class="font-display text-lg font-semibold">Grupo Alpha</span>
      </div>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-papel/70">
        Equipamos cocinas profesionales con las mejores marcas del mundo.
        Precios, descuentos y cotización en línea para todo Latinoamérica.
      </p>
      <a href="/cotizacion" class="mt-5 inline-flex text-sm font-semibold text-cobre-claro hover:underline">
        Solicitar cotización →
      </a>
    </div>

    <div>
      <h3 class="eyebrow !text-cobre-claro">Divisions</h3>
      <ul class="mt-4 space-y-2.5 text-sm text-papel/80">
        <li><a class="hover:text-cobre-claro" href="/productos">Gastronomía</a></li>
        <li><span class="text-papel/40">Panadería</span> <em class="text-xs not-italic text-papel/35">(pronto)</em></li>
        <li><span class="text-papel/40">Frío</span> <em class="text-xs not-italic text-papel/35">(pronto)</em></li>
        <li><span class="text-papel/40">Bebidas</span> <em class="text-xs not-italic text-papel/35">(pronto)</em></li>
      </ul>
    </div>

    <div>
      <h3 class="eyebrow !text-cobre-claro">Ubicaciones</h3>
      <ul class="mt-4 grid grid-cols-1 gap-2.5 text-sm text-papel/80">
        {paises.map((p) => <li>{p}</li>)}
      </ul>
    </div>

    <div>
      <h3 class="eyebrow !text-cobre-claro">Contacto</h3>
      <ul class="mt-4 space-y-2.5 text-sm text-papel/80">
        <li>Lun–Vie 9:00–18:30 · Sáb 9:00–14:00</li>
        <li><a class="hover:text-cobre-claro" href="tel:5555332385">55 5533 2385</a></li>
        <li><a class="hover:text-cobre-claro" href="mailto:soporte@grupoalpha.com">soporte@grupoalpha.com</a></li>
        <li class="pt-2">
          <a
            href="https://wa.me/5215555332385"
            target="_blank"
            rel="noopener"
            class="btn btn-primary !py-2 !px-4 text-sm"
          >
            WhatsApp
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-papel/10">
    <div class="container-x flex flex-col items-center justify-between gap-2 py-5 text-xs text-papel/50 sm:flex-row">
      <p>© {year} Grupo Alpha. Todos los derechos reservados.</p>
      <p class="flex gap-4">
        <a class="hover:text-papel" href="#">Aviso de privacidad</a>
        <a class="hover:text-papel" href="#">Términos y condiciones</a>
      </p>
    </div>
  </div>
</footer>

<a
  href="https://wa.me/5215555332385?text=Hola,%20me%20interesa%20un%20equipo%20de%20cocina"
  target="_blank"
  rel="noopener"
  aria-label="Chatear por WhatsApp"
  class="fixed bottom-5 right-5 z-50 grid size-13 place-items-center rounded-full bg-exito p-3.5 text-white shadow-lg transition-transform hover:scale-105"
>
  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm0 18.03c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.26 8.26 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24s8.24 3.7 8.24 8.24-3.7 8.24-8.24 8.24zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.29z"/>
  </svg>
</a>
