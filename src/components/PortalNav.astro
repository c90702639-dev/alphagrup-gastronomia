---
interface Props {
  active: "inicio" | "ia" | "leads" | "cotizador" | "documentos" | "uso";
  subtitle?: string;
}
const { active, subtitle } = Astro.props;

const links = [
  { key: "inicio", href: "/portal", label: "Inicio" },
  { key: "ia", href: "/portal/chat", label: "Asistente IA" },
  { key: "leads", href: "/portal/leads", label: "Leads" },
  { key: "cotizador", href: "/portal/cotizador", label: "Cotizador" },
  { key: "documentos", href: "/portal/documentos", label: "Documentos" },
  { key: "uso", href: "/portal/uso", label: "Uso de IA" },
];
---

<div class="border-b border-linea bg-tinta text-papel">
  <div class="container-x flex flex-wrap items-center justify-between gap-3 py-3">
    <div class="flex items-center gap-3">
      <span class="grid size-8 place-items-center bg-cobre font-display font-bold text-white">α</span>
      <div>
        <p class="font-display leading-none">Portal de ventas</p>
        {subtitle && <p class="mt-1 text-xs text-papel/60">{subtitle}</p>}
      </div>
    </div>

    <nav class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm" aria-label="Portal">
      {
        links.map((l) =>
          l.key === active ? (
            <a href={l.href} class="text-cobre-claro underline underline-offset-4">
              {l.label}
            </a>
          ) : (
            <a href={l.href} class="text-papel/70 transition-colors hover:text-papel">
              {l.label}
            </a>
          )
        )
      }
      <a href="/" class="text-papel/50 hover:text-papel">Sitio web ↗</a>
      <a href="/api/logout" class="text-papel/50 hover:text-papel">Salir</a>
    </nav>
  </div>
</div>
